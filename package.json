{
  "name": "crosscheck",
  "version": "0.1.0",
  "description": "Independent verification runtime for AI-generated code",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": {
    "crosscheck": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build":        "tsup",
    "build:bin":    "tsup --config tsup.binary.config.ts && node scripts/pkg-build.mjs",
    "prepare":      "husky || true",
    "prepack":      "npm run build",
    "dev":          "tsx src/cli/index.ts",
    "test":         "vitest run",
    "eval":         "node scripts/evaluate.mjs",
    "test:watch":   "vitest",
    "lint":         "eslint src --ext .ts",
    "typecheck":    "tsc --noEmit",
    "format":       "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check":        "npm run lint && npm run typecheck && npm run format:check",
    "fix":          "eslint src --ext .ts --fix && npm run format"
  },
  "pkg": {
    "scripts": "dist-bin/index.cjs",
    "assets": [],
    "targets": [
      "node20-linux-x64",
      "node20-linux-arm64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-win-x64"
    ],
    "outputPath": "releases"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "date-fns": "^3.6.0",
    "execa": "^9.4.0",
    "minimatch": "^10.2.6",
    "nanoid": "^5.0.7",
    "ora": "^8.1.1",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^9.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": ["ai", "code-review", "verification", "claude", "coding-agent", "security"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crosscheck-sh/crosscheck"
  },
  "packageManager": "pnpm@9.12.0"
}
